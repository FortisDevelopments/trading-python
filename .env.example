# =============================================================================
# Standard - Same Equity Curve (2025-06-25)
# Copy to .env and fill in secrets:  cp .env.example .env
# Search repo for "Standard - Same Equity Curve" for sim / live / notebook parity.
# =============================================================================

# -----------------------------------------------------------------------------
# Live bot identity (api_liveScript.py, logger_api.py, sync_fills.py)
# -----------------------------------------------------------------------------
BOT_ID=btc_4h_live_usdt_1304

# -----------------------------------------------------------------------------
# Model + signal (Standard - Same Equity Curve — aligned with notebook search)
# V2_Bot_BTC.ipynb winner: ModelId740 @ 4h / horizon 6 (2026-06-25)
# -----------------------------------------------------------------------------
MODEL_PATH=ModelId740_4784.92%_4h_6_Time_2026-06-25_18-45-56.joblib
RESAMPLE_RULE=4h
HORIZON_STEPS=6
TARGET_SIMPLE_RETURN=0.003472
THRESHOLD=0.4214

# -----------------------------------------------------------------------------
# Live trading sizing + exits (aligned with simulation defaults 2025-06-25)
# -----------------------------------------------------------------------------
TAKE_PROFIT=0.0455
STOP_LOSS=0.0051
MAX_OPEN_TRADES=3
PCT_ACCOUNT_PER_TRADE=0.7888

# -----------------------------------------------------------------------------
# Market
# -----------------------------------------------------------------------------
SYMBOL=BTCUSDT
QUOTE_ASSET=USDT

# -----------------------------------------------------------------------------
# Safety — keep 0 until you intend to place real orders on Binance LIVE
# -----------------------------------------------------------------------------
ENABLE_LIVE_TRADING=0

# -----------------------------------------------------------------------------
# Binance LIVE (api_liveScript.py, sync_fills.py, equity_tracker.py)
# -----------------------------------------------------------------------------
BINANCE_LIVE_API_KEY=your_live_api_key_here
BINANCE_LIVE_API_SECRET=your_live_api_secret_here

# -----------------------------------------------------------------------------
# Binance TESTNET (api_testScript.py only — separate defaults, not sim-aligned)
# -----------------------------------------------------------------------------
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# -----------------------------------------------------------------------------
# Logging (api_liveScript.py, logger_api.py)
# -----------------------------------------------------------------------------
ENABLE_API_LOGGING=1
ENABLE_CSV_LOGGING=1
TRADE_LOG_PATH=trade_log_live.csv

# Node/Express backend for run + order logs
API_BASE_URL=http://127.0.0.1:3000
API_TOKEN=
API_TIMEOUT=10
API_RETRIES=3

# -----------------------------------------------------------------------------
# Fill sync cron (sync_fills.py)
# -----------------------------------------------------------------------------
FILLS_SYMBOL=BTCUSDT
FILLS_LOOKBACK_MINUTES=240
FILLS_STATE_PATH=fills_state_BTCUSDT.json

# -----------------------------------------------------------------------------
# Equity tracker (equity_tracker.py)
# -----------------------------------------------------------------------------
EQUITY_SYMBOL=BTCUSDT

# =============================================================================
# Testnet overrides (api_testScript.py) — only if running test script separately
# Uncomment and use a different .env or export these when testing on testnet.
# =============================================================================
# BOT_ID=btc_4h_testnet3
# MODEL_PATH=btc_4h_xgb_classifier.joblib
